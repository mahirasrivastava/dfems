<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.dfems.controller.AuditController"
            style="-fx-background-color:#ecf0f1;">

    <top>
        <HBox style="-fx-background-color:#2c3e50; -fx-padding:12 20;"
              spacing="16" alignment="CENTER_LEFT">
            <Button text="⬅ Dashboard" onAction="#goBack"
                    style="-fx-background-color:#7f8c8d; -fx-text-fill:white; -fx-cursor:hand;"/>
            <Label text="📊  Audit Log"
                   style="-fx-text-fill:white; -fx-font-size:18; -fx-font-weight:bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="🔄 Refresh" onAction="#handleRefresh"
                    style="-fx-background-color:#27ae60; -fx-text-fill:white; -fx-cursor:hand;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="10" style="-fx-padding:18;">

            <!-- Filter Bar -->
            <HBox spacing="10" alignment="CENTER_LEFT"
                  style="-fx-background-color:white; -fx-padding:10;
                         -fx-border-color:#dfe6e9; -fx-background-radius:6; -fx-border-radius:6;">
                <Label text="Search:" style="-fx-font-weight:bold;"/>
                <TextField fx:id="searchField" promptText="Username or details..."
                           prefWidth="220" prefHeight="32"/>
                <Label text="Action:" style="-fx-font-weight:bold;"/>
                <ComboBox fx:id="actionFilterCombo" prefWidth="180" prefHeight="32"/>
                <Button text="🔍 Filter"  onAction="#handleFilter"
                        style="-fx-background-color:#2980b9; -fx-text-fill:white; -fx-cursor:hand;"/>
                <Button text="✖ Clear"   onAction="#handleClearFilter"
                        style="-fx-background-color:#95a5a6; -fx-text-fill:white; -fx-cursor:hand;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="totalLabel" style="-fx-font-weight:bold; -fx-text-fill:#2c3e50;"/>
            </HBox>

            <!-- Table -->
            <TableView fx:id="auditTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colLogId"    text="Log ID"   prefWidth="65"/>
                    <TableColumn fx:id="colUser"     text="User"     prefWidth="130"/>
                    <TableColumn fx:id="colRole"     text="Role"     prefWidth="120"/>
                    <TableColumn fx:id="colAction"   text="Action"   prefWidth="180"/>
                    <TableColumn fx:id="colTimestamp" text="Timestamp" prefWidth="160"/>
                    <TableColumn fx:id="colDetails"  text="Details"  prefWidth="380"/>
                </columns>
                <placeholder><Label text="No audit logs found."/></placeholder>
            </TableView>

            <Label fx:id="statusLabel" style="-fx-font-weight:bold;"/>
        </VBox>
    </center>
</BorderPane>
