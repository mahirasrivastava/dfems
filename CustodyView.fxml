<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.dfems.controller.CustodyController"
            style="-fx-background-color:#ecf0f1;">

    <top>
        <HBox style="-fx-background-color:#2c3e50; -fx-padding:12 20;"
              spacing="16" alignment="CENTER_LEFT">
            <Button text="⬅ Dashboard" onAction="#goBack"
                    style="-fx-background-color:#7f8c8d; -fx-text-fill:white; -fx-cursor:hand;"/>
            <Label text="🔗  Chain of Custody"
                   style="-fx-text-fill:white; -fx-font-size:18; -fx-font-weight:bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="🔄 Refresh" onAction="#handleRefresh"
                    style="-fx-background-color:#27ae60; -fx-text-fill:white; -fx-cursor:hand;"/>
        </HBox>
    </top>

    <center>
        <SplitPane orientation="HORIZONTAL" dividerPositions="0.32">

            <!-- LEFT: Transfer Form -->
            <VBox spacing="12" style="-fx-padding:20; -fx-background-color:white;" minWidth="280">
                <Label text="Record Custody Action"
                       style="-fx-font-size:14; -fx-font-weight:bold; -fx-text-fill:#2c3e50;"/>
                <Separator/>

                <Label text="Evidence ID *" style="-fx-font-weight:bold;"/>
                <TextField fx:id="evidenceIdField" promptText="e.g. 5001" prefHeight="34"/>

                <Label text="Action *" style="-fx-font-weight:bold;"/>
                <ComboBox fx:id="actionCombo" maxWidth="Infinity" prefHeight="34"/>

                <Label text="User *" style="-fx-font-weight:bold;"/>
                <ComboBox fx:id="userCombo" maxWidth="Infinity" prefHeight="34"
                          promptText="Select user..."/>

                <Label text="Remarks" style="-fx-font-weight:bold;"/>
                <TextArea fx:id="remarksArea" prefHeight="90" wrapText="true"
                          promptText="Optional notes about this action..."/>

                <Separator/>

                <Button text="✔ Record Transfer" onAction="#handleTransfer"
                        maxWidth="Infinity" prefHeight="40"
                        style="-fx-background-color:#2c3e50; -fx-text-fill:white;
                               -fx-font-size:13; -fx-font-weight:bold; -fx-cursor:hand;"/>

                <Label fx:id="statusLabel" wrapText="true" style="-fx-font-weight:bold;"/>
            </VBox>

            <!-- RIGHT: Full Custody Table -->
            <VBox spacing="8" style="-fx-padding:15;">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Complete Chain of Custody Records"
                           style="-fx-font-size:14; -fx-font-weight:bold;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="totalLabel" style="-fx-text-fill:#7f8c8d;"/>
                </HBox>
                <TableView fx:id="custodyTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCustodyId" text="ID"        prefWidth="55"/>
                        <TableColumn fx:id="colEvidence"  text="Evidence"  prefWidth="180"/>
                        <TableColumn fx:id="colUser"      text="User"      prefWidth="130"/>
                        <TableColumn fx:id="colAction"    text="Action"    prefWidth="110"/>
                        <TableColumn fx:id="colTime"      text="Timestamp" prefWidth="160"/>
                        <TableColumn fx:id="colRemarks"   text="Remarks"   prefWidth="220"/>
                    </columns>
                    <placeholder><Label text="No custody records found."/></placeholder>
                </TableView>
            </VBox>

        </SplitPane>
    </center>
</BorderPane>
