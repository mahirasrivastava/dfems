<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.dfems.controller.DashboardController"
            style="-fx-background-color:#ecf0f1;">

    <!-- TOP BAR -->
    <top>
        <HBox style="-fx-background-color:#2c3e50; -fx-padding:12 20;"
              spacing="16" alignment="CENTER_LEFT">
            <Label text="🔍 DFEMS"
                   style="-fx-text-fill:white; -fx-font-size:22; -fx-font-weight:bold;"/>
            <Label text="|" style="-fx-text-fill:#7f8c8d;"/>
            <Label text="Case Management Dashboard"
                   style="-fx-text-fill:#bdc3c7; -fx-font-size:13;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="welcomeLabel" style="-fx-text-fill:white; -fx-font-weight:bold;"/>
            <Label fx:id="roleLabel"
                   style="-fx-text-fill:#3498db; -fx-font-size:11;
                          -fx-border-color:#3498db; -fx-border-radius:10;
                          -fx-padding:2 8; -fx-background-color:#1a252f;
                          -fx-background-radius:10;"/>
            <Button text="Logout" onAction="#handleLogout"
                    style="-fx-background-color:#e74c3c; -fx-text-fill:white;
                           -fx-cursor:hand; -fx-background-radius:4;"/>
        </HBox>
    </top>

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox style="-fx-background-color:#34495e; -fx-padding:10 5;"
              spacing="3" prefWidth="210">
            <Label text="NAVIGATION"
                   style="-fx-text-fill:#7f8c8d; -fx-font-size:10;
                          -fx-padding:10 10 4 10; -fx-font-weight:bold;"/>
            <Button text="📋  All Cases"      onAction="#handleRefresh"   maxWidth="Infinity" styleClass="nav-btn"/>
            <Button text="➕  New Case"       onAction="#openNewCase"     maxWidth="Infinity" styleClass="nav-btn"/>
            <Button text="📁  Evidence"       onAction="#openEvidence"    maxWidth="Infinity" styleClass="nav-btn"/>
            <Button text="🔬  Analysis"       onAction="#openAnalysis"    maxWidth="Infinity" styleClass="nav-btn"/>
            <Button text="📄  Reports"        onAction="#openReports"     maxWidth="Infinity" styleClass="nav-btn"/>
            <Button text="🔗  Chain of Custody" onAction="#openCustody"  maxWidth="Infinity" styleClass="nav-btn"/>
            <Button text="📊  Audit Log"      onAction="#openAuditLog"    maxWidth="Infinity" styleClass="nav-btn"/>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <VBox spacing="12" style="-fx-padding:20;">

            <!-- Toolbar -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="searchField"
                           promptText="🔍  Search by case number, location, description..."
                           prefWidth="380" prefHeight="36"/>
                <Button text="Search"  onAction="#handleSearch"
                        style="-fx-background-color:#2980b9; -fx-text-fill:white; -fx-cursor:hand;"/>
                <Button text="Refresh" onAction="#handleRefresh"
                        style="-fx-background-color:#27ae60; -fx-text-fill:white; -fx-cursor:hand;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="➕ New Case" onAction="#openNewCase"
                        style="-fx-background-color:#e67e22; -fx-text-fill:white;
                               -fx-font-weight:bold; -fx-cursor:hand;"/>
                <Button text="Open Selected Case" onAction="#handleViewCase"
                        style="-fx-background-color:#2c3e50; -fx-text-fill:white; -fx-cursor:hand;"/>
            </HBox>

            <!-- Table -->
            <TableView fx:id="caseTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId"        text="ID"         prefWidth="65"/>
                    <TableColumn fx:id="colNumber"    text="Case No."   prefWidth="150"/>
                    <TableColumn fx:id="colType"      text="Type"       prefWidth="130"/>
                    <TableColumn fx:id="colStatus"    text="Status"     prefWidth="155"/>
                    <TableColumn fx:id="colLocation"  text="Location"   prefWidth="180"/>
                    <TableColumn fx:id="colEvidence"  text="Evidence"   prefWidth="80"/>
                    <TableColumn fx:id="colCreatedBy" text="Created By" prefWidth="130"/>
                </columns>
                <placeholder><Label text="No cases found."/></placeholder>
            </TableView>

            <!-- Footer -->
            <HBox alignment="CENTER_LEFT">
                <Label fx:id="totalCasesLabel"
                       style="-fx-text-fill:#7f8c8d; -fx-font-size:12;"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
