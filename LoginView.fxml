<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.dfems.controller.LoginController"
      alignment="CENTER" spacing="18"
      style="-fx-padding: 80 120; -fx-background-color: #ecf0f1;">

    <Label text="🔐 DFEMS"
           style="-fx-font-size:36; -fx-font-weight:bold; -fx-text-fill:#2c3e50;"/>
    <Label text="Digital Forensic Evidence Management System"
           style="-fx-font-size:14; -fx-text-fill:#7f8c8d;"/>

    <Separator prefWidth="320"/>

    <VBox spacing="6" maxWidth="320">
        <Label text="Email Address" style="-fx-font-weight:bold;"/>
        <TextField fx:id="emailField" promptText="your.email@dfems.gov"
                   prefWidth="320" prefHeight="38" onKeyPressed="#handleEnter"/>

        <Label text="Password" style="-fx-font-weight:bold;"/>
        <PasswordField fx:id="passwordField" promptText="••••••••"
                       prefWidth="320" prefHeight="38" onKeyPressed="#handleEnter"/>
    </VBox>

    <Label fx:id="errorLabel" style="-fx-text-fill:#e74c3c; -fx-font-weight:bold;" wrapText="true" maxWidth="320"/>

    <Button fx:id="loginBtn" text="Login" onAction="#handleLogin"
            prefWidth="320" prefHeight="42"
            style="-fx-background-color:#2c3e50; -fx-text-fill:white; -fx-font-size:15; -fx-font-weight:bold; -fx-cursor:hand; -fx-background-radius:6;"/>

    <Label text="Test logins: arjun.sharma@dfems.gov  |  priya.nair@dfems.gov  |  admin@dfems.gov"
           style="-fx-font-size:11; -fx-text-fill:#95a5a6;" wrapText="true" maxWidth="360" alignment="CENTER"/>
</VBox>
