<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.dfems.controller.ReportController"
            style="-fx-background-color:#ecf0f1;">

    <top>
        <HBox style="-fx-background-color:#2c3e50; -fx-padding:12 20;"
              spacing="16" alignment="CENTER_LEFT">
            <Button text="⬅ Dashboard" onAction="#goBack"
                    style="-fx-background-color:#7f8c8d; -fx-text-fill:white; -fx-cursor:hand;"/>
            <Label text="📄  Forensic Reports"
                   style="-fx-text-fill:white; -fx-font-size:18; -fx-font-weight:bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="🔄 Refresh" onAction="#handleRefresh"
                    style="-fx-background-color:#27ae60; -fx-text-fill:white; -fx-cursor:hand;"/>
        </HBox>
    </top>

    <center>
        <SplitPane orientation="HORIZONTAL" dividerPositions="0.4">

            <!-- LEFT: List + Generate -->
            <VBox spacing="12" style="-fx-padding:18; -fx-background-color:white;">
                <Label text="Generate New Report"
                       style="-fx-font-size:14; -fx-font-weight:bold;"/>
                <Separator/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Case ID *" style="-fx-font-weight:bold;"/>
                        <TextField fx:id="genCaseIdField" promptText="e.g. 1001" prefHeight="32"/>
                    </VBox>
                    <VBox spacing="4">
                        <Label text="Type" style="-fx-font-weight:bold;"/>
                        <ComboBox fx:id="reportTypeCombo" prefWidth="120" prefHeight="32"/>
                    </VBox>
                </HBox>
                <Button text="📄 Generate Report" onAction="#handleGenerate"
                        maxWidth="Infinity" prefHeight="36"
                        style="-fx-background-color:#2c3e50; -fx-text-fill:white;
                               -fx-font-weight:bold; -fx-cursor:hand;"/>
                <Label fx:id="statusLabel" wrapText="true" style="-fx-font-weight:bold;"/>

                <Separator/>
                <HBox alignment="CENTER_LEFT">
                    <Label text="All Reports" style="-fx-font-size:14; -fx-font-weight:bold;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="totalLabel" style="-fx-text-fill:#7f8c8d;"/>
                </HBox>
                <TableView fx:id="reportTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colReportId"  text="ID"         prefWidth="45"/>
                        <TableColumn fx:id="colCaseNum"   text="Case No."   prefWidth="130"/>
                        <TableColumn fx:id="colCreatedBy" text="Created By" prefWidth="110"/>
                        <TableColumn fx:id="colDate"      text="Date"       prefWidth="100"/>
                        <TableColumn fx:id="colType"      text="Type"       prefWidth="90"/>
                    </columns>
                    <placeholder><Label text="No reports found."/></placeholder>
                </TableView>
            </VBox>

            <!-- RIGHT: Preview -->
            <VBox spacing="10" style="-fx-padding:18; -fx-background-color:#fdfefe;">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Report Preview"
                           style="-fx-font-size:14; -fx-font-weight:bold;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="📤 Export to File" onAction="#handleExport"
                            style="-fx-background-color:#2980b9; -fx-text-fill:white; -fx-cursor:hand;"/>
                </HBox>
                <Separator/>
                <TextArea fx:id="reportPreviewArea" editable="false"
                          VBox.vgrow="ALWAYS" wrapText="true"
                          promptText="Select a report from the list to preview it here..."
                          style="-fx-font-family:'Courier New'; -fx-font-size:12;"/>
            </VBox>

        </SplitPane>
    </center>
</BorderPane>
